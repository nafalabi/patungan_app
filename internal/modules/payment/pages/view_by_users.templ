package payment_pages

import (
	"fmt"
	"patungan_app_echo/internal/models"
)

// ViewByUsers renders payment dues grouped by users
templ ViewByUsers(userWithDues []UserWithDues, currentUserID uint, currentUserType models.UserType, nextOffset int) {
	if len(userWithDues) == 0 {
		<div class="bg-bg-card rounded-xl border border-border p-8 text-center text-text-secondary">
			No users with payment dues found.
		</div>
	} else {
		<div id="users-container" class="space-y-8">
			@UserListItems(userWithDues, currentUserID, currentUserType)
		</div>
		
		@LoadMoreUsersButton(nextOffset)
	}
}

// UserListItems renders user groups
templ UserListItems(userWithDues []UserWithDues, currentUserID uint, currentUserType models.UserType) {
	for _, uwd := range userWithDues {
		<div class="bg-bg-card rounded-2xl border border-border overflow-hidden shadow-sm">
			<!-- User header -->
			<div class="bg-bg-hover/30 border-b border-border p-5">
				<div class="flex justify-between items-center">
					<div class="flex items-center gap-4">
						<div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold text-xl border-2 border-white shadow-sm">
							{ uwd.User.Name[0:1] }
						</div>
						<div>
							<h3 class="text-xl font-extrabold text-text-primary">{ uwd.User.Name }</h3>
							<p class="text-sm text-text-secondary font-medium">{ uwd.User.Email }</p>
						</div>
					</div>
					<div class="text-right">
						<span class="text-xs font-black bg-white px-3 py-1 rounded-full border border-border text-text-secondary uppercase">
							{ fmt.Sprintf("%d total dues", len(uwd.Dues)) }
						</span>
					</div>
				</div>
			</div>
			
			<!-- Plans for this user -->
			<div class="p-5">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					for _, due := range uwd.Dues {
						<div class="border border-border/80 rounded-xl p-4 bg-bg-body/20 hover:bg-white hover:shadow-md hover:border-primary/20 transition-all duration-200">
							<div class="flex justify-between items-start mb-3">
								<div class="flex items-center gap-2">
									<div class="p-1.5 bg-primary/5 rounded-lg">
										<i data-lucide="layout" class="w-4 h-4 text-primary"></i>
									</div>
									<h4 class="font-bold text-text-primary truncate max-w-[150px]">{ due.Plan.Name }</h4>
								</div>
								@PaymentStatusIcon(due.PaymentStatus)
							</div>
							
							<div class="flex justify-between items-end mt-2">
								<div class="text-xs text-text-secondary">
									<p>Due: <span class="font-bold text-text-primary">{ due.DueDate.Format("02 Jan 06") }</span></p>
									if due.BillingPeriod.ID != 0 {
										<p class="mt-0.5">{ due.BillingPeriod.Name }</p>
									}
								</div>
								<div class="text-right">
									<p class="text-sm font-black text-text-primary">Rp { fmt.Sprintf("%.2f", due.CalculatedPayAmount) }</p>
									if due.UserID == currentUserID && due.PaymentStatus != "paid" {
										<a href={ templ.SafeURL(fmt.Sprintf("/p/%s", due.UUID)) } class="text-[10px] text-primary font-bold hover:underline">Pay Now →</a>
									}
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	}
}

templ LoadMoreUsersButton(nextOffset int) {
	<div class="mt-10 flex justify-center" id="load-more-users-container" hx-swap-oob="true">
		if nextOffset > 0 {
			<button
				hx-get={ fmt.Sprintf("/payment-dues?view=users&offset=%d", nextOffset) }
				hx-target="#users-container"
				hx-swap="beforeend"
				hx-indicator="#load-more-users-spinner"
				class="px-6 py-3 bg-white text-text-primary border-2 border-border rounded-2xl font-bold hover:border-primary hover:text-primary transition-all duration-300 shadow-sm flex items-center gap-2"
			>
				<i data-lucide="user-plus" class="w-5 h-5"></i>
				<span>Load More Users</span>
				<div id="load-more-users-spinner" class="htmx-indicator animate-spin h-4 w-4 border-2 border-primary border-t-transparent rounded-full"></div>
			</button>
		}
	</div>
}
