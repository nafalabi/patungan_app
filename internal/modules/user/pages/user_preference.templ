package user_pages

import (
	"fmt"
	"patungan_app_echo/internal/models"
)

// UserPreferencePopup renders the notification preference popup
templ UserPreferencePopup(user models.User, pref models.UserNotifPreference) {
	<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-xs p-4" id="notif-pref-modal">
		<div class="bg-bg-card rounded-2xl border border-border shadow-popover p-6 w-full max-w-md relative animate-in fade-in zoom-in-95 duration-150">
			<button class="absolute top-4 right-4 text-text-muted hover:text-text-primary transition-colors p-1 rounded-lg hover:bg-bg-hover" onclick="document.getElementById('notif-pref-modal').remove()">
				<i data-lucide="x" class="w-4 h-4"></i>
			</button>

			<div class="mb-5">
				<h2 class="text-lg font-bold text-text-primary tracking-tight">Notification Settings</h2>
				<p class="text-xs text-text-secondary mt-0.5">User: <span class="font-semibold text-text-primary">{ user.Name }</span></p>
			</div>

			<form hx-put={ fmt.Sprintf("/users/%d/preference", user.ID) } hx-target="#notif-pref-modal" hx-swap="outerHTML">
				<div class="space-y-4">
					<!-- Channel Selection -->
					<div>
						<label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Preferred Channel</label>
						<div class="grid grid-cols-3 gap-2.5">
							<label class="flex items-center gap-2 p-2.5 rounded-lg border border-border bg-bg-card hover:bg-bg-hover cursor-pointer transition-colors">
								<input type="radio" name="channel" value="none" class="text-primary focus:ring-primary" 
									checked?={ pref.Channel == models.NotificationChannelNone || pref.Channel == "" }
									onchange="toggleWhatsappOptions(false)"/>
								<span class="text-xs font-semibold text-text-primary">None</span>
							</label>
							<label class="flex items-center gap-2 p-2.5 rounded-lg border border-border bg-bg-card hover:bg-bg-hover cursor-pointer transition-colors">
								<input type="radio" name="channel" value="email" class="text-primary focus:ring-primary" 
									checked?={ pref.Channel == models.NotificationChannelEmail }
									onchange="toggleWhatsappOptions(false)"/>
								<span class="text-xs font-semibold text-text-primary">Email</span>
							</label>
							<label class="flex items-center gap-2 p-2.5 rounded-lg border border-border bg-bg-card hover:bg-bg-hover cursor-pointer transition-colors">
								<input type="radio" name="channel" value="whatsapp" class="text-primary focus:ring-primary" 
									checked?={ pref.Channel == models.NotificationChannelWhatsapp }
									onchange="toggleWhatsappOptions(true)"/>
								<span class="text-xs font-semibold text-text-primary">WhatsApp</span>
							</label>
						</div>
					</div>

					<!-- WhatsApp Options -->
					<div id="whatsapp-options" class={ "p-4 bg-bg-subtle/70 rounded-xl border border-border space-y-3 transition-all duration-150", templ.KV("hidden", pref.Channel != models.NotificationChannelWhatsapp) }>
						<label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1">WhatsApp Target</label>
						<div class="flex gap-4">
							<label class="inline-flex items-center cursor-pointer">
								<input type="radio" name="whatsapp_target_type" value="personal" class="text-primary focus:ring-primary"
									checked?={ pref.WhatsappTargetType == models.WhatsappTargetTypePersonal }
									onchange="toggleGroupInput(false)"/>
								<span class="ml-2 text-xs font-medium text-text-primary">Personal</span>
							</label>
							<label class="inline-flex items-center cursor-pointer">
								<input type="radio" name="whatsapp_target_type" value="group" class="text-primary focus:ring-primary"
									checked?={ pref.WhatsappTargetType == models.WhatsappTargetTypeGroup }
									onchange="toggleGroupInput(true)"/>
								<span class="ml-2 text-xs font-medium text-text-primary">Group</span>
							</label>
						</div>
						
						<div id="group-id-container" class={ "pt-2 transition-all duration-150", templ.KV("hidden", pref.WhatsappTargetType != models.WhatsappTargetTypeGroup) }>
							<label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1">Group ID (Chat ID)</label>
							<input type="text" name="whatsapp_group_id" value={ pref.WhatsappGroupID }
								class="w-full px-3 py-1.5 bg-bg-card border border-border rounded-lg text-text-primary focus:outline-none focus:ring-1 focus:ring-primary text-xs font-mono"
								placeholder="e.g. 123456789@g.us"/>
							<p class="text-[10px] text-text-muted mt-1">Get this ID from WAHA logs or API.</p>
						</div>
					</div>
				</div>

				<div class="flex justify-end gap-2 mt-6 pt-4 border-t border-border">
					<button type="button" onclick="document.getElementById('notif-pref-modal').remove()" 
						class="px-3.5 py-2 text-text-secondary hover:text-text-primary bg-bg-card border border-border rounded-lg text-xs font-semibold hover:bg-bg-hover transition-colors">
						Cancel
					</button>
					<button type="submit" class="px-4 py-2 text-white bg-primary rounded-lg text-xs font-semibold hover:bg-primary-hover transition-colors shadow-xs">
						Save Preferences
					</button>
				</div>
			</form>

			<script>
				function toggleWhatsappOptions(show) {
					const el = document.getElementById('whatsapp-options');
					if (show) el.classList.remove('hidden');
					else el.classList.add('hidden');
				}
				function toggleGroupInput(show) {
					const el = document.getElementById('group-id-container');
					if (show) el.classList.remove('hidden');
					else el.classList.add('hidden');
				}
			</script>
		</div>
	</div>
}

// UserPreferenceSuccess is returned after a successful update to show a toast and close the modal
templ UserPreferenceSuccess() {
	<script>
		(function() {
			const toast = document.createElement('div');
			toast.style.position = 'fixed';
			toast.style.bottom = '1.5rem';
			toast.style.right = '1.5rem';
			toast.style.zIndex = '99999';
			toast.style.backgroundColor = '#18181b';
			toast.style.color = '#fafafa';
			toast.style.border = '1px solid #27272a';
			toast.style.padding = '0.6rem 1.2rem';
			toast.style.borderRadius = '0.5rem';
			toast.style.fontSize = '0.75rem';
			toast.style.fontWeight = '600';
			toast.style.boxShadow = '0 10px 15px -3px rgba(0, 0, 0, 0.2)';
			toast.style.transition = 'all 0.2s ease';
			toast.style.opacity = '0';
			toast.style.transform = 'translateY(0.5rem)';
			toast.innerText = 'Preferences saved successfully';
			
			document.body.appendChild(toast);
			
			setTimeout(() => {
				toast.style.opacity = '1';
				toast.style.transform = 'translateY(0)';
			}, 10);
			
			setTimeout(() => {
				toast.style.opacity = '0';
				toast.style.transform = 'translateY(0.5rem)';
				setTimeout(() => toast.remove(), 300);
			}, 2500);

			// Self-destruct: remove this script tag from the DOM
			const script = document.currentScript;
			if (script) {
				setTimeout(() => script.remove(), 100);
			}
		})();
	</script>
}

