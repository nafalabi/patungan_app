package payment_pages

import (
	"fmt"
	"patungan_app_echo/internal/models"
)

// ViewByPeriods renders payment dues grouped by billing periods
templ ViewByPeriods(periodWithPlans []PeriodWithPlans, currentUserID uint, currentUserType models.UserType, nextOffset int) {
	if len(periodWithPlans) == 0 {
		<div class="bg-bg-card rounded-xl border border-border p-8 text-center text-text-secondary shadow-card">
			No billing periods found.
		</div>
	} else {
		<div id="periods-container" class="space-y-6">
			@PeriodListItems(periodWithPlans, currentUserID, currentUserType)
		</div>
		
		@LoadMorePeriodsButton(nextOffset)
	}
}

// PeriodListItems renders period groups
templ PeriodListItems(periodWithPlans []PeriodWithPlans, currentUserID uint, currentUserType models.UserType) {
	for _, pwp := range periodWithPlans {
		<div class="bg-bg-card rounded-xl border border-border overflow-hidden shadow-card">
			<!-- Period header -->
			<div class="bg-bg-subtle/50 border-b border-border p-4">
				<div class="flex justify-between items-center">
					<div class="flex items-center gap-3">
						<div class="w-8 h-8 rounded-lg bg-bg-card border border-border flex items-center justify-center text-text-primary">
							<i data-lucide="calendar-range" class="w-4 h-4"></i>
						</div>
						<div>
							<h3 class="text-base font-bold text-text-primary tracking-tight">
								if pwp.Period.ID != 0 {
									{ pwp.Period.Name }
								} else {
									{ pwp.Plans[0].Dues[0].DueDate.Format("January 2006") } (Uncategorized)
								}
							</h3>
							<p class="text-xs text-text-secondary">Billing cycle starting { pwp.Period.DueDate.Format("02 Jan 2006") }</p>
						</div>
					</div>
				</div>
			</div>
			
			<!-- Plans in this period -->
			<div class="p-4 space-y-4">
				<div id={ fmt.Sprintf("period-%d-plans", pwp.Period.ID) } class="space-y-4">
					@PeriodPlanItems(pwp.Period.ID, pwp.Plans, currentUserID, currentUserType)
				</div>
			</div>
		</div>
	}
}

templ LoadMorePeriodsButton(nextOffset int) {
	<div class="mt-6 flex justify-center" id="load-more-periods-container" hx-swap-oob="true">
		if nextOffset > 0 {
			<button
				hx-get={ fmt.Sprintf("/payment-dues?view=periods&offset=%d", nextOffset) }
				hx-target="#periods-container"
				hx-swap="beforeend"
				hx-indicator="#load-more-periods-spinner"
				class="px-4 py-2 bg-primary text-white rounded-lg text-xs font-semibold hover:bg-primary-hover transition-colors shadow-xs flex items-center gap-2 cursor-pointer"
			>
				<span>Load Previous Periods</span>
				<div id="load-more-periods-spinner" class="htmx-indicator animate-spin h-3.5 w-3.5 border-2 border-white border-t-transparent rounded-full"></div>
			</button>
		}
	</div>
}

// PeriodPlanItems renders plans within a period
templ PeriodPlanItems(periodID uint, plans []PlanWithDuesInPeriod, currentUserID uint, currentUserType models.UserType) {
	for _, plan_dues := range plans {
		<div class="border border-border/80 rounded-lg overflow-hidden bg-bg-card">
			<div class="bg-bg-subtle/60 px-4 py-2 border-b border-border/80 flex justify-between items-center">
				<h4 class="font-bold text-text-primary text-xs flex items-center gap-2">
					<i data-lucide="package" class="w-3.5 h-3.5 text-text-secondary"></i>
					{ plan_dues.Plan.Name }
				</h4>
				<span class="text-[10px] font-semibold bg-bg-card px-2 py-0.5 rounded-md border border-border text-text-secondary uppercase tracking-tight">
					{ fmt.Sprintf("%d participants", len(plan_dues.Dues)) }
				</span>
			</div>
			<div class="divide-y divide-border/60">
				for _, due := range plan_dues.Dues {
					@PaymentDueItem(due, "user", currentUserID, currentUserType)
				}
			</div>
		</div>
	}
}

