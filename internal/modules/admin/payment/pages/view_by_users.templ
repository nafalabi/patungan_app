package payment_pages

import (
	"fmt"
	"patungan_app_echo/internal/models"
	"patungan_app_echo/internal/template/utils"
)

// ViewByUsers renders payment dues grouped by users
templ ViewByUsers(userWithDues []UserWithDues, currentUserID uint, currentUserType models.UserType, nextOffset int) {
	if len(userWithDues) == 0 {
		<div class="bg-bg-card rounded-xl border border-border p-8 text-center text-text-secondary shadow-card">
			No users with payment dues found.
		</div>
	} else {
		<div id="users-container" class="space-y-6">
			@UserListItems(userWithDues, currentUserID, currentUserType)
		</div>
		
		@LoadMoreUsersButton(nextOffset)
	}
}

// UserListItems renders user groups
templ UserListItems(userWithDues []UserWithDues, currentUserID uint, currentUserType models.UserType) {
	for _, uwd := range userWithDues {
		<div class="bg-bg-card rounded-xl border border-border overflow-hidden shadow-card">
			<!-- User header -->
			<div class="bg-bg-subtle/50 border-b border-border p-4">
				<div class="flex justify-between items-center">
					<div class="flex items-center gap-3">
						<div class="w-9 h-9 bg-zinc-900 rounded-full flex items-center justify-center text-white font-bold text-xs shadow-xs">
							{ utils.SafeInitial(uwd.User.Name, "U") }
						</div>
						<div>
							<h3 class="text-sm font-bold text-text-primary leading-tight">{ uwd.User.Name }</h3>
							<p class="text-xs text-text-secondary font-mono mt-0.5">{ uwd.User.Email }</p>
						</div>
					</div>
					<div>
						<span class="text-[10px] font-semibold bg-bg-card px-2 py-0.5 rounded-md border border-border text-text-secondary uppercase">
							{ fmt.Sprintf("%d total dues", len(uwd.Dues)) }
						</span>
					</div>
				</div>
			</div>
			
			<!-- Plans for this user -->
			<div class="p-4">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
					for _, due := range uwd.Dues {
						<div class="border border-border/80 rounded-lg p-3.5 bg-bg-card hover:bg-bg-hover/40 transition-colors">
							<div class="flex justify-between items-start mb-2.5">
								<div class="flex items-center gap-2">
									<div class="w-6 h-6 rounded-md bg-bg-subtle border border-border flex items-center justify-center text-text-primary text-xs">
										<i data-lucide="layers" class="w-3.5 h-3.5"></i>
									</div>
									<h4 class="font-bold text-xs text-text-primary truncate max-w-[140px]">{ due.Plan.Name }</h4>
								</div>
								@PaymentStatusIcon(due.PaymentStatus)
							</div>
							
							<div class="flex justify-between items-end mt-2 pt-2 border-t border-border/60">
								<div class="text-xs text-text-secondary">
									<p>Due: <span class="font-semibold text-text-primary font-mono">{ due.DueDate.Format("02 Jan 2006") }</span></p>
									if due.BillingPeriod.ID != 0 {
										<p class="text-[11px] text-text-muted mt-0.5">{ due.BillingPeriod.Name }</p>
									}
								</div>
								<div class="text-right">
									<p class="text-xs font-bold text-text-primary font-mono">{ formatRupiah(due.CalculatedPayAmount) }</p>
									if due.UserID == currentUserID && due.PaymentStatus != "paid" {
										<a href={ templ.SafeURL(fmt.Sprintf("/p/%s", due.UUID)) } class="text-[11px] text-primary font-semibold hover:underline mt-0.5 inline-block">Pay Now →</a>
									}
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	}
}

templ LoadMoreUsersButton(nextOffset int) {
	<div class="mt-6 flex justify-center" id="load-more-users-container" hx-swap-oob="true">
		if nextOffset > 0 {
			<button
				hx-get={ fmt.Sprintf("/admin/payment-dues?view=users&offset=%d", nextOffset) }
				hx-target="#users-container"
				hx-swap="beforeend"
				hx-indicator="#load-more-users-spinner"
				class="px-4 py-2 bg-bg-card text-text-primary border border-border rounded-lg text-xs font-semibold hover:bg-bg-hover transition-colors shadow-xs flex items-center gap-2 cursor-pointer"
			>
				<i data-lucide="user-plus" class="w-4 h-4"></i>
				<span>Load More Users</span>
				<div id="load-more-users-spinner" class="htmx-indicator animate-spin h-3.5 w-3.5 border-2 border-primary border-t-transparent rounded-full"></div>
			</button>
		}
	</div>
}

