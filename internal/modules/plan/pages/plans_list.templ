package plan_pages

import (	
	"fmt"
	"strings"
	"patungan_app_echo/internal/models"
	"patungan_app_echo/internal/template/layouts"
	types "patungan_app_echo/internal/template/types"
	"patungan_app_echo/internal/template/utils"
)

// PlansListProps contains props for the plans list page
type PlansListProps struct {
	Title       string
	ActiveNav   string
	Breadcrumbs []types.Breadcrumb
	UserEmail   string
	UserUID     string
	Plans       []models.Plan

	// Filtering
	FilterOwner uint
	FilterType  string

	// Sorting
	SortBy    string
	SortOrder string

	// Pagination
	CurrentPage int
	TotalPages  int
	TotalCount  int
	PageSize    int

	// For dropdowns
	AllUsers []models.User
}

// PlansList renders the plans list page with improved card-based UI
templ PlansList(props PlansListProps) {
	@layouts.Base(layouts.BaseProps{
		Title:       props.Title,
		ActiveNav:   props.ActiveNav,
		Breadcrumbs: props.Breadcrumbs,
		UserEmail:   props.UserEmail,
		UserUID:     props.UserUID,
	}) {
		<!-- Header -->
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
			<div>
				<h1 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight">Plans</h1>
				<p class="text-xs md:text-sm text-text-secondary mt-0.5">
					Showing { fmt.Sprintf("%d", props.TotalCount) } active subscription plans
				</p>
			</div>
			<a href="/plans/create" class="w-full sm:w-auto inline-flex justify-center items-center gap-2 px-4 py-2 rounded-lg font-semibold text-xs no-underline transition-all duration-150 bg-primary text-white hover:bg-primary-hover shadow-sm">
				<i data-lucide="plus" class="w-4 h-4"></i>
				Create New Plan
			</a>
		</div>

		<!-- Filters and Sorting -->
		<div class="bg-bg-card rounded-xl border border-border p-4 mb-6 shadow-card">
			<form id="filter-form" method="get" action="/plans">
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
					<!-- Filter by Owner -->
					<div>
						<label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1.5">Owner</label>
						<select 
							name="filter_owner"
							class="w-full px-3 py-1.5 bg-bg-body border border-border rounded-lg text-text-primary text-xs focus:outline-none focus:ring-1 focus:ring-primary"
							onchange="this.form.submit()"
						>
							<option value="">All Owners</option>
							for _, user := range props.AllUsers {
								<option value={ fmt.Sprintf("%d", user.ID) } selected?={ props.FilterOwner == user.ID }>
									{ user.Name }
								</option>
							}
						</select>
					</div>
					<!-- Filter by Type -->
					<div>
						<label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1.5">Payment Type</label>
						<select 
							name="filter_type"
							class="w-full px-3 py-1.5 bg-bg-body border border-border rounded-lg text-text-primary text-xs focus:outline-none focus:ring-1 focus:ring-primary"
							onchange="this.form.submit()"
						>
							<option value="">All Types</option>
							<option value="onetime" selected?={ props.FilterType == "onetime" }>One-time</option>
							<option value="recurring" selected?={ props.FilterType == "recurring" }>Recurring</option>
						</select>
					</div>
					<!-- Sort By -->
					<div>
						<label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1.5">Sort By</label>
						<select 
							name="sort_by"
							class="w-full px-3 py-1.5 bg-bg-body border border-border rounded-lg text-text-primary text-xs focus:outline-none focus:ring-1 focus:ring-primary"
							onchange="this.form.submit()"
						>
							<option value="created" selected?={ props.SortBy == "created" }>Created Date</option>
							<option value="name" selected?={ props.SortBy == "name" }>Name</option>
							<option value="date" selected?={ props.SortBy == "date" }>Start Date</option>
							<option value="price" selected?={ props.SortBy == "price" }>Price</option>
						</select>
					</div>
					<!-- Sort Order -->
					<div>
						<label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1.5">Order</label>
						<select 
							name="sort_order"
							class="w-full px-3 py-1.5 bg-bg-body border border-border rounded-lg text-text-primary text-xs focus:outline-none focus:ring-1 focus:ring-primary"
							onchange="this.form.submit()"
						>
							<option value="asc" selected?={ props.SortOrder == "asc" }>Ascending</option>
							<option value="desc" selected?={ props.SortOrder == "desc" }>Descending</option>
						</select>
					</div>
				</div>
				<!-- Hidden inputs to preserve state -->
				<input type="hidden" name="page" value="1"/>
			</form>
			if props.FilterOwner > 0 || props.FilterType != "" {
				<div class="mt-3 pt-3 border-t border-border/60 flex items-center justify-between">
					<span class="text-xs text-text-secondary">Active filters applied</span>
					<a 
						href="/plans"
						class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-border text-text-secondary hover:text-text-primary hover:bg-bg-hover transition-colors text-xs font-medium"
					>
						<i data-lucide="x" class="w-3 h-3"></i>
						Clear Filters
					</a>
				</div>
			}
		</div>

		<!-- Plans Grid -->
		if len(props.Plans) == 0 {
			<div class="bg-bg-card rounded-xl border border-border p-12 text-center shadow-card">
				<div class="w-12 h-12 rounded-full bg-bg-subtle border border-border flex items-center justify-center text-text-secondary mx-auto mb-3">
					<i data-lucide="inbox" class="w-6 h-6"></i>
				</div>
				<h3 class="text-sm font-semibold text-text-primary">No plans found</h3>
				<p class="text-xs text-text-secondary mt-1">Get started by creating your first shared subscription plan.</p>
				<a href="/plans/create" class="inline-flex items-center gap-1.5 px-4 py-2 mt-4 rounded-lg bg-primary text-white text-xs font-semibold hover:bg-primary-hover transition-colors shadow-sm">
					<i data-lucide="plus" class="w-4 h-4"></i>
					Create your first plan
				</a>
			</div>
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
				for _, plan := range props.Plans {
					@PlanCard(plan)
				}
			</div>
		}

		<!-- Pagination -->
		if props.TotalPages > 1 {
			<div class="mt-6 flex flex-col sm:flex-row justify-between items-center gap-3">
				<div class="text-xs text-text-secondary">
					Page { fmt.Sprintf("%d", props.CurrentPage) } of { fmt.Sprintf("%d", props.TotalPages) }
				</div>
				<div class="flex items-center gap-1.5">
					if props.CurrentPage > 1 {
						<a 
							href={ templ.SafeURL(buildPlanURL("/plans", props.FilterOwner, props.FilterType, props.SortBy, props.SortOrder, props.CurrentPage-1)) }
							class="px-3 py-1.5 bg-bg-card text-text-secondary hover:text-text-primary border border-border rounded-lg text-xs font-medium hover:bg-bg-hover transition-colors"
						>
							Previous
						</a>
					}
					<div class="flex gap-1">
						for i := 1; i <= props.TotalPages; i++ {
							if i == props.CurrentPage {
								<span class="px-3 py-1.5 bg-primary text-white rounded-lg text-xs font-semibold shadow-xs">
									{ fmt.Sprintf("%d", i) }
								</span>
							} else if i == 1 || i == props.TotalPages || (i >= props.CurrentPage-2 && i <= props.CurrentPage+2) {
								<a 
									href={ templ.SafeURL(buildPlanURL("/plans", props.FilterOwner, props.FilterType, props.SortBy, props.SortOrder, i)) }
									class="px-3 py-1.5 bg-bg-card text-text-secondary hover:text-text-primary border border-border rounded-lg text-xs font-medium hover:bg-bg-hover transition-colors"
								>
									{ fmt.Sprintf("%d", i) }
								</a>
							} else if i == props.CurrentPage-3 || i == props.CurrentPage+3 {
								<span class="px-2 py-1.5 text-xs text-text-muted">...</span>
							}
						}
					</div>
					if props.CurrentPage < props.TotalPages {
						<a 
							href={ templ.SafeURL(buildPlanURL("/plans", props.FilterOwner, props.FilterType, props.SortBy, props.SortOrder, props.CurrentPage+1)) }
							class="px-3 py-1.5 bg-bg-card text-text-secondary hover:text-text-primary border border-border rounded-lg text-xs font-medium hover:bg-bg-hover transition-colors"
						>
							Next
						</a>
					}
				</div>
			</div>
		}
		<div id="global-modal"></div>
	}
}

// PlanCard renders a single plan as a card
templ PlanCard(plan models.Plan) {
	<div class="bg-bg-card rounded-xl border border-border overflow-hidden shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
		<!-- Card Header & Content -->
		<div class="p-5 space-y-4">
			<!-- Header Row -->
			<div class="flex justify-between items-start gap-3">
				<div class="flex items-center gap-3">
					<div class="w-9 h-9 rounded-lg bg-bg-subtle border border-border flex items-center justify-center font-bold text-sm text-text-primary flex-shrink-0">
						{ string([]rune(plan.Name)[0:1]) }
					</div>
					<div>
						<h3 class="text-base font-bold text-text-primary tracking-tight leading-snug">{ plan.Name }</h3>
						<p class="text-xs text-text-secondary mt-0.5">
							if plan.Owner.Name != "" {
								<span>{ plan.Owner.Name }</span>
							} else {
								<span class="italic text-text-muted">No owner assigned</span>
							}
						</p>
					</div>
				</div>
				@PaymentTypeBadge(plan.PaymentType)
			</div>

			<!-- Price & Next Due Box -->
			<div class="bg-bg-subtle/70 rounded-lg p-3 border border-border/60 flex justify-between items-center">
				<div>
					<span class="text-[10px] font-semibold uppercase tracking-wider text-text-secondary block">Total Price</span>
					<span class="text-base font-bold text-text-primary tracking-tight">{ utils.FormatRupiahSimple(plan.TotalPrice) }</span>
				</div>
				<div class="text-right">
					<span class="text-[10px] font-semibold uppercase tracking-wider text-text-secondary block">Next Due</span>
					<span class="text-xs font-semibold text-text-primary font-mono">{ plan.NextDue().Format("02 Jan 2006") }</span>
				</div>
			</div>

			<!-- Participants Avatar Stack & Split Info -->
			<div class="flex items-center justify-between pt-1">
				<div class="flex items-center">
					if len(plan.Participants) > 0 {
						<div class="flex items-center -space-x-1.5 mr-2.5">
							for i, participant := range plan.Participants {
								if i < 3 {
									<div class="w-6 h-6 rounded-full bg-zinc-800 text-white flex items-center justify-center text-[9px] font-bold border-2 border-white" title={ participant.User.Name }>
										{ getUserInitials(participant.User.Name) }
									</div>
								}
							}
							if len(plan.Participants) > 3 {
								<div class="w-6 h-6 rounded-full bg-zinc-400 text-white flex items-center justify-center text-[9px] font-bold border-2 border-white">
									{ fmt.Sprintf("+%d", len(plan.Participants)-3) }
								</div>
							}
						</div>
						<div class="text-xs text-text-secondary">
							<span class="font-medium text-text-primary">{ fmt.Sprintf("%d", len(plan.Participants)) }</span> members
							if len(plan.Participants) > 0 {
								<span class="text-text-muted text-[11px]">({ utils.FormatRupiahSimple(plan.TotalPrice/float64(len(plan.Participants))) }/ea)</span>
							}
						</div>
					} else {
						<span class="text-xs text-text-muted italic">No participants</span>
					}
				</div>
				<!-- Schedule Status -->
				<div>
					if plan.ScheduledTask == nil {
						<span class="text-[11px] font-medium text-text-muted bg-bg-subtle border border-border px-2 py-0.5 rounded-full">
							Manual
						</span>
					} else {
						@StatusBadge(string(plan.ScheduledTask.Status), string(plan.PaymentType))
					}
				</div>
			</div>
		</div>

		<!-- Card Actions -->
		<div class="px-5 py-3 bg-bg-subtle/40 border-t border-border flex items-center gap-2">
			<button 
				hx-get={ fmt.Sprintf("/plans/%d/schedule-popup", plan.ID) }
				hx-target="#global-modal"
				class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-border font-semibold transition-colors bg-bg-card text-text-primary hover:bg-bg-hover text-xs shadow-xs"
			>
				<i data-lucide="calendar" class="w-3.5 h-3.5 text-text-secondary"></i>
				Schedule
			</button>
			<a 
				href={ templ.SafeURL(fmt.Sprintf("/plans/%d/edit", plan.ID)) }
				class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg font-semibold no-underline transition-colors bg-primary text-white hover:bg-primary-hover text-xs shadow-xs"
			>
				<i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
				Edit
			</a>
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/plans/%d/delete", plan.ID)) } onsubmit="return confirm('Are you sure you want to delete this plan?')" class="inline-flex">
				<button 
					type="submit"
					class="p-1.5 rounded-lg border border-border text-text-muted hover:text-rose-600 hover:bg-rose-50 transition-colors"
					title="Delete plan"
				>
					<i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
				</button>
			</form>
		</div>
	</div>
}

// PaymentTypeBadge renders a badge for payment type
templ PaymentTypeBadge(paymentType string) {
	if paymentType == "recurring" {
		<span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-bg-subtle text-text-secondary border border-border">Recurring</span>
	} else {
		<span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">One-time</span>
	}
}

// buildPlanURL is a helper function to build plan list URLs with query parameters
func buildPlanURL(base string, filterOwner uint, filterType string, sortBy string, sortOrder string, page int) string {
	url := fmt.Sprintf("%s?page=%d", base, page)
	if filterOwner > 0 {
		url += fmt.Sprintf("&filter_owner=%d", filterOwner)
	}
	if filterType != "" {
		url += fmt.Sprintf("&filter_type=%s", filterType)
	}
	if sortBy != "" {
		url += fmt.Sprintf("&sort_by=%s", sortBy)
	}
	if sortOrder != "" {
		url += fmt.Sprintf("&sort_order=%s", sortOrder)
	}
	return url
}

func getUserInitials(name string) string {
	name = strings.TrimSpace(name)
	if len(name) == 0 {
		return "?"
	}
	parts := strings.Split(name, " ")
	if len(parts) == 1 {
		runes := []rune(parts[0])
		if len(runes) >= 2 {
			return strings.ToUpper(string(runes[:2]))
		}
		return strings.ToUpper(string(runes[:1]))
	}
	r1 := []rune(parts[0])
	r2 := []rune(parts[1])
	return strings.ToUpper(fmt.Sprintf("%s%s", string(r1[:1]), string(r2[:1])))
}

