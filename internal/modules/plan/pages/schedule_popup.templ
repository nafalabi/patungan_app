package plan_pages

import (	
	"fmt"
	"patungan_app_echo/internal/models"
)

// SchedulePopup renders the schedule management popup
templ SchedulePopup(plan models.Plan) {
	<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-xs p-4" id="schedule-popup">
		<div class="bg-bg-card rounded-2xl border border-border shadow-popover p-6 w-full max-w-md relative animate-in fade-in zoom-in-95 duration-150">
			<button class="absolute top-4 right-4 text-text-muted hover:text-text-primary transition-colors p-1 rounded-lg hover:bg-bg-hover" onclick="document.getElementById('schedule-popup').remove()">
				<i data-lucide="x" class="w-4 h-4"></i>
			</button>

			<div class="mb-5">
				<h2 class="text-lg font-bold text-text-primary tracking-tight">Manage Schedule</h2>
				<p class="text-xs text-text-secondary mt-0.5">Plan: <span class="font-semibold text-text-primary">{ plan.Name }</span></p>
			</div>

			<div class="space-y-4">
				<div class="bg-bg-subtle/70 rounded-xl p-4 border border-border/70 space-y-2.5">
					<div class="flex justify-between items-center">
						<span class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Current Status</span>
						if plan.ScheduledTask == nil {
							<span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-bg-card text-text-muted border border-border">Not Scheduled</span>
						} else {
							@StatusBadge(string(plan.ScheduledTask.Status), string(plan.PaymentType))
						}
					</div>
					if plan.ScheduledTask != nil {
						<div class="flex justify-between items-center text-xs">
							<span class="text-text-secondary">Current Due</span>
							<span class="text-text-primary font-semibold font-mono">{ plan.ScheduledTask.Due.Format("02 Jan 2006, 15:04") }</span>
						</div>
					}
					if plan.ScheduledTask != nil && (plan.ScheduledTask.Status == models.ScheduledTaskStatusFailure || plan.ScheduledTask.Status == models.ScheduledTaskStatusDisabled) {
						<div class="flex justify-between items-center text-xs">
							<span class="text-text-secondary">New Due</span>
							<span class="text-text-primary font-semibold font-mono">{ plan.NextDue().Format("02 Jan 2006, 15:04") }</span>
						</div>
					}
				</div>

				<div class="flex flex-col gap-2 pt-2">
					if plan.ScheduledTask == nil {
						<!-- Not Scheduled -> Schedule Plan -->
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/plans/%d/schedule", plan.ID)) }>
							<button type="submit" class="w-full inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-lg font-semibold text-xs bg-primary text-white hover:bg-primary-hover transition-colors shadow-sm">
								<i data-lucide="calendar-plus" class="w-4 h-4"></i>
								Schedule Automatic Reminders
							</button>
						</form>
					} else if plan.ScheduledTask.Status == models.ScheduledTaskStatusActive {
						<!-- Active -> Disable -->
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/plans/%d/disable-schedule", plan.ID)) }>
							<button type="submit" class="w-full inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-lg font-semibold text-xs border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100 transition-colors">
								<i data-lucide="calendar-off" class="w-4 h-4"></i>
								Disable Schedule
							</button>
						</form>
					} else if plan.ScheduledTask.Status == models.ScheduledTaskStatusFailure || plan.ScheduledTask.Status == models.ScheduledTaskStatusDisabled {
						<!-- Failure/Disabled -> Reschedule -->
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/plans/%d/schedule", plan.ID)) }>
							<button type="submit" class="w-full inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-lg font-semibold text-xs bg-primary text-white hover:bg-primary-hover transition-colors shadow-sm">
								<i data-lucide="refresh-cw" class="w-4 h-4"></i>
								Reschedule Plan
							</button>
						</form>
					} else if plan.ScheduledTask.Status == models.ScheduledTaskStatusDone {
						<p class="text-center text-xs text-text-secondary italic">This plan is completed.</p>
					}
				</div>
			</div>
		</div>
	</div>
}

// StatusBadge renders the status badge
templ StatusBadge(status string, paymentType string) {
	switch status {
	case "active":
		if (paymentType == "onetime") {
			<span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-amber-50 text-amber-800 border border-amber-200">Scheduled</span>
		} else {
			<span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">Active</span>
		}
	case "done":
		<span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">Dispatched</span>
	case "failure":
		<span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-rose-50 text-rose-800 border border-rose-200">Failed</span>
	case "disabled":
		<span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-bg-subtle text-text-muted border border-border">Disabled</span>
	default:
		<span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-bg-subtle text-text-secondary border border-border">{ status }</span>
	}
}

