package plan_pages
import (	

	"fmt"
	"patungan_app_echo/internal/models"
	"patungan_app_echo/internal/template/layouts"
	types "patungan_app_echo/internal/template/types"
)

// PlanFormProps contains props for the plan form page
type PlanFormProps struct {
	Title              string
	ActiveNav          string
	Breadcrumbs        []types.Breadcrumb
	UserEmail          string
	UserUID            string
	IsEdit             bool
	Plan               models.Plan
	FormattedStartDate string
	AllUsers           []models.User // Available users to select
	// key: UserID, value: Portion (default 1)
	ParticipantPortions map[uint]int
	ErrorMessage        string
}

// PlanForm renders the plan create/edit form
templ PlanForm(props PlanFormProps) {
	@layouts.Base(layouts.BaseProps{
		Title:       props.Title,
		ActiveNav:   props.ActiveNav,
		Breadcrumbs: props.Breadcrumbs,
		UserEmail:   props.UserEmail,
		UserUID:     props.UserUID,
	}) {
		<div class="max-w-2xl mx-auto p-6 sm:p-8 bg-bg-card rounded-2xl border border-border shadow-card">
			<div class="mb-6">
				<h1 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight">
					if props.IsEdit {
						Edit Plan
					} else {
						Create New Plan
					}
				</h1>
				<p class="text-xs text-text-secondary mt-0.5">Configure subscription details, billing frequency, and member splits.</p>
			</div>
			
			if props.ErrorMessage != "" {
				<div class="mb-5 rounded-xl bg-rose-50 p-4 border border-rose-200 flex items-start gap-3">
					<i data-lucide="alert-circle" class="w-5 h-5 text-rose-600 flex-shrink-0 mt-0.5"></i>
					<div>
						<h3 class="text-xs font-bold text-rose-900">Error Saving Plan</h3>
						<p class="text-xs text-rose-700 mt-0.5">{ props.ErrorMessage }</p>
					</div>
				</div>
			}
			<form method="POST" action={ formAction(props.IsEdit, props.Plan.ID) } class="space-y-4">
				<div>
					<label class="block mb-1.5 text-xs font-semibold text-text-secondary uppercase tracking-wider">Plan Name</label>
					<input
						type="text"
						name="name"
						placeholder="e.g. Netflix 4K UHD, Spotify Family"
						class="w-full px-3.5 py-2 rounded-lg border border-border bg-input-bg text-text-primary text-sm focus:outline-none focus:ring-1 focus:ring-primary placeholder:text-text-muted"
						value={ props.Plan.Name }
						required
					/>
				</div>
				<div>
					<label class="block mb-1.5 text-xs font-semibold text-text-secondary uppercase tracking-wider">Total Price (IDR)</label>
					<input
						type="number"
						name="total_price"
						placeholder="186000"
						class="w-full px-3.5 py-2 rounded-lg border border-border bg-input-bg text-text-primary text-sm focus:outline-none focus:ring-1 focus:ring-primary font-mono placeholder:text-text-muted"
						value={ fmt.Sprintf("%.0f", props.Plan.TotalPrice) }
						required
					/>
				</div>
				<!-- Payment Type & Recurring Options (Alpine.js) -->
				<div
					class="space-y-4"
					x-data={ fmt.Sprintf("recurringForm('%s', '%s')", props.Plan.PaymentType, derefString(props.Plan.RecurringInterval)) }
				>
					<div>
						<label class="block mb-1.5 text-xs font-semibold text-text-secondary uppercase tracking-wider">Payment Type</label>
						<div class="grid grid-cols-2 gap-3">
							<label class="flex items-center gap-2.5 p-3 rounded-lg border border-border bg-bg-card hover:bg-bg-hover cursor-pointer transition-colors" :class="paymentType === 'onetime' ? 'border-primary ring-1 ring-primary bg-bg-subtle/50' : ''">
								<input
									type="radio"
									name="payment_type"
									value="onetime"
									x-model="paymentType"
									@change="updateRRule"
									class="text-primary focus:ring-primary"
								/>
								<div>
									<span class="text-xs font-bold text-text-primary block">One-time</span>
									<span class="text-[11px] text-text-secondary block">Single event split</span>
								</div>
							</label>
							<label class="flex items-center gap-2.5 p-3 rounded-lg border border-border bg-bg-card hover:bg-bg-hover cursor-pointer transition-colors" :class="paymentType === 'recurring' ? 'border-primary ring-1 ring-primary bg-bg-subtle/50' : ''">
								<input
									type="radio"
									name="payment_type"
									value="recurring"
									x-model="paymentType"
									@change="updateRRule"
									class="text-primary focus:ring-primary"
								/>
								<div>
									<span class="text-xs font-bold text-text-primary block">Recurring</span>
									<span class="text-[11px] text-text-secondary block">Periodic subscription</span>
								</div>
							</label>
						</div>
					</div>
					<!-- Recurring Options -->
					<div x-show="paymentType === 'recurring'" class="p-4 border border-border rounded-xl bg-bg-subtle/70 space-y-3" x-transition>
						<div>
							<label class="block mb-1.5 text-xs font-semibold text-text-secondary uppercase tracking-wider">Billing Frequency</label>
							<select
								x-model="frequency"
								@change="updateRRule"
								class="w-full px-3 py-2 rounded-lg border border-border bg-bg-card text-text-primary text-xs focus:outline-none focus:ring-1 focus:ring-primary"
							>
								<option value="DAILY">Daily</option>
								<option value="WEEKLY">Weekly</option>
								<option value="MONTHLY">Monthly</option>
								<option value="YEARLY">Yearly</option>
							</select>
						</div>
						<div>
							<label class="block mb-1.5 text-xs font-semibold text-text-secondary uppercase tracking-wider">Interval</label>
							<div class="flex items-center gap-2 text-xs">
								<span class="text-text-secondary font-medium">Every</span>
								<input
									type="number"
									min="1"
									x-model="interval"
									@input="updateRRule"
									class="w-16 px-2.5 py-1.5 rounded-lg border border-border bg-bg-card text-text-primary text-xs focus:outline-none focus:ring-1 focus:ring-primary font-mono"
								/>
								<span class="text-text-primary font-medium" x-text="frequency.toLowerCase().replace('ly', '(s)')"></span>
							</div>
						</div>
						<!-- Hidden Input for RRULE -->
						<input type="hidden" name="recurring_interval" x-model="rruleString"/>
					</div>
					<div>
						<label class="block mb-1.5 text-xs font-semibold text-text-secondary uppercase tracking-wider">Start Date</label>
						<input
							type="date"
							name="plan_start_date"
							class="w-full px-3.5 py-2 rounded-lg border border-border bg-input-bg text-text-primary text-sm focus:outline-none focus:ring-1 focus:ring-primary"
							value={ props.FormattedStartDate }
							required
						/>
					</div>
				</div>
				<!-- Participants & Portions -->
				<div>
					<div class="flex items-center justify-between mb-1.5">
						<label class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Select Participants</label>
						<span class="text-[11px] text-text-secondary">Default portion: 1</span>
					</div>
					<div class="space-y-1.5 border border-border rounded-xl p-3 max-h-60 overflow-y-auto bg-bg-subtle/30">
						if len(props.AllUsers) == 0 {
							<p class="text-text-secondary text-xs p-2">No users available. Add users first.</p>
						} else {
							for _, user := range props.AllUsers {
								<div
									class="flex flex-col p-2.5 hover:bg-bg-hover rounded-lg border border-transparent hover:border-border/60 transition-all"
									x-data={ fmt.Sprintf("{ selected: %v, portion: %d }", props.ParticipantPortions[user.ID] > 0, max(1, props.ParticipantPortions[user.ID])) }
								>
									<label class="flex items-center cursor-pointer">
										<input
											type="checkbox"
											name="participants"
											value={ fmt.Sprintf("%d", user.ID) }
											id={ fmt.Sprintf("user-%d", user.ID) }
											class="mr-3 h-4 w-4 rounded border-border bg-bg-card text-primary focus:ring-primary"
											x-model="selected"
										/>
										<div class="flex flex-col select-none">
											<span class="text-text-primary text-xs font-bold">{ user.Name }</span>
											<span class="text-text-secondary text-[11px]">{ user.Email }</span>
										</div>
									</label>
									<div class="mt-2 ml-7 flex items-center gap-2" x-show="selected" x-transition>
										<label for={ fmt.Sprintf("portion-%d", user.ID) } class="text-[11px] text-text-secondary font-semibold uppercase tracking-wider">Portion:</label>
										<input
											type="number"
											name={ fmt.Sprintf("portion_%d", user.ID) }
											id={ fmt.Sprintf("portion-%d", user.ID) }
											x-model="portion"
											min="1"
											class="w-16 px-2 py-1 bg-bg-card border border-border rounded-md text-text-primary text-xs focus:outline-none focus:ring-1 focus:ring-primary font-mono"
											:disabled="!selected"
										/>
									</div>
								</div>
							}
						}
					</div>
				</div>
				<div class="flex items-center gap-2.5 pt-2">
					<input
						type="checkbox"
						name="allow_invitation"
						id="allow_invitation"
						class="w-4 h-4 rounded border-border text-primary focus:ring-primary"
						checked?={ props.Plan.AllowInvitationAfterPay }
					/>
					<label for="allow_invitation" class="text-xs font-medium text-text-primary cursor-pointer select-none">Allow members to invite friends after paying</label>
				</div>
				<div class="pt-4 flex flex-col sm:flex-row gap-2.5">
					<button type="submit" class="flex-1 inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-lg font-semibold transition-colors bg-primary text-white hover:bg-primary-hover text-xs shadow-sm cursor-pointer">
						<i data-lucide="check" class="w-4 h-4"></i>
						Save Plan
					</button>
					<a href="/plans" class="inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-lg border border-border font-semibold no-underline transition-colors bg-bg-card text-text-secondary hover:text-text-primary hover:bg-bg-hover text-xs">
						Cancel
					</a>
				</div>
			</form>
		</div>
		<script>
			document.addEventListener('alpine:init', () => {
				Alpine.data('recurringForm', (initialType, initialRRule) => ({
					paymentType: initialType || 'onetime',
					frequency: 'WEEKLY',
					interval: 1,
					rruleString: initialRRule || '',
					init() {
						// Use a timeout to ensure rrule is loaded if deferred
						setTimeout(() => {
							if (this.paymentType === 'recurring' && this.rruleString && typeof rrule !== 'undefined') {
								try {
									const rule = rrule.rrulestr(this.rruleString);
									const options = rule.options;
									const freqMap = {};
									freqMap[rrule.RRule.DAILY] = 'DAILY';
									freqMap[rrule.RRule.WEEKLY] = 'WEEKLY';
									freqMap[rrule.RRule.MONTHLY] = 'MONTHLY';
									freqMap[rrule.RRule.YEARLY] = 'YEARLY';
									
									if (freqMap[options.freq]) {
										this.frequency = freqMap[options.freq];
									}
									if (options.interval) {
										this.interval = options.interval;
									}
								} catch (e) {
									console.error("Failed to parse RRULE:", e);
									this.updateRRule();
								}
							} else {
								this.updateRRule();
							}
						}, 100);
					},
					updateRRule() {
						if (this.paymentType !== 'recurring' || typeof rrule === 'undefined') {
							this.rruleString = '';
							return;
						}
						const freqMap = {
							'DAILY': rrule.RRule.DAILY,
							'WEEKLY': rrule.RRule.WEEKLY,
							'MONTHLY': rrule.RRule.MONTHLY,
							'YEARLY': rrule.RRule.YEARLY
						};
						const rule = new rrule.RRule({
							freq: freqMap[this.frequency],
							interval: parseInt(this.interval)
						});
						this.rruleString = rule.toString();
					}
				}))
			})
		</script>
	}
}

// Helper function to generate form action URL
func formAction(isEdit bool, planID uint) templ.SafeURL {
	if isEdit {
		return templ.SafeURL(fmt.Sprintf("/plans/%d/update", planID))
	}
	return templ.SafeURL("/plans")
}

func derefString(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}

func max(a, b int) int {
	if a > b {
		return a
	}
	return b
}
