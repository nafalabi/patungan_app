package plan_pages

import (
	"fmt"
	"patungan_app_echo/internal/models"
	"patungan_app_echo/internal/template/layouts"
	types "patungan_app_echo/internal/template/types"
	"patungan_app_echo/internal/template/utils"
)

type MemberPlanDetailProps struct {
	Title          string
	ActiveNav      string
	Breadcrumbs    []types.Breadcrumb
	UserEmail      string
	UserUID        string
	CurrentUserID  uint
	Plan           models.Plan
	BillingPeriods []models.PaymentBillingPeriod
}

templ MemberPlanDetail(props MemberPlanDetailProps) {
	@layouts.Base(layouts.BaseProps{
		Title:       props.Title,
		ActiveNav:   props.ActiveNav,
		Breadcrumbs: props.Breadcrumbs,
		UserEmail:   props.UserEmail,
		UserUID:     props.UserUID,
		Role:        "member",
	}) {
		<div class="space-y-6">
			<!-- Header -->
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
				<div class="flex items-center gap-3">
					<a href="/member/plans" class="p-2 rounded-lg border border-border bg-bg-card hover:bg-bg-hover text-text-secondary hover:text-text-primary transition-colors">
						<i data-lucide="arrow-left" class="w-4 h-4"></i>
					</a>
					<div>
						<h1 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight">{ props.Plan.Name }</h1>
						<p class="text-xs md:text-sm text-text-secondary mt-0.5">
							Created by <span class="font-semibold text-text-primary">{ props.Plan.Owner.Name }</span>
						</p>
					</div>
				</div>
				<span class="px-3 py-1 rounded-full text-xs font-semibold bg-bg-subtle text-text-primary border border-border capitalize">
					{ string(props.Plan.PaymentType) } Plan
				</span>
			</div>

			<!-- Overview Cards -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
				<div class="p-5 bg-bg-card border border-border rounded-xl shadow-card">
					<p class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Total Plan Price</p>
					<h3 class="text-xl font-bold text-text-primary mt-1 font-mono">{ utils.FormatRupiah(props.Plan.TotalPrice) }</h3>
					<p class="text-[11px] text-text-muted mt-1">Full subscription cost</p>
				</div>
				<div class="p-5 bg-bg-card border border-border rounded-xl shadow-card">
					<p class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Total Members</p>
					<h3 class="text-xl font-bold text-text-primary mt-1 font-mono">{ fmt.Sprintf("%d members", len(props.Plan.Participants)) }</h3>
					<p class="text-[11px] text-text-muted mt-1">Splitting the total bill</p>
				</div>
				<div class="p-5 bg-bg-card border border-border rounded-xl shadow-card">
					<p class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Start Date</p>
					<h3 class="text-xl font-bold text-text-primary mt-1 font-mono">{ props.Plan.PlanStartDate.Format("02 Jan 2006") }</h3>
					<p class="text-[11px] text-text-muted mt-1">Plan initiated</p>
				</div>
			</div>

			<!-- Two Columns: Participants & Payment History -->
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<!-- Left Column: Participants (1 col) -->
				<div class="lg:col-span-1 space-y-4">
					<div class="bg-bg-card rounded-xl border border-border shadow-card overflow-hidden">
						<div class="px-5 py-4 border-b border-border flex items-center justify-between">
							<h2 class="text-sm font-bold text-text-primary tracking-tight flex items-center gap-2">
								<i data-lucide="users" class="w-4 h-4 text-text-secondary"></i>
								Participants
							</h2>
							<span class="text-xs text-text-muted">{ fmt.Sprintf("%d", len(props.Plan.Participants)) }</span>
						</div>
						<div class="p-4 divide-y divide-border/60">
							for _, p := range props.Plan.Participants {
								<div class="py-3 first:pt-0 last:pb-0 flex items-center justify-between gap-3">
									<div class="flex items-center gap-2.5 min-w-0">
										<div class="w-7 h-7 rounded-full bg-zinc-900 text-white flex items-center justify-center text-xs font-bold shrink-0">
											{ utils.SafeInitial(p.User.Name, "U") }
										</div>
										<div class="min-w-0">
											<p class="text-xs font-semibold text-text-primary truncate">{ p.User.Name }</p>
											<p class="text-[11px] text-text-muted truncate">{ p.User.Email }</p>
										</div>
									</div>
									if p.User.ID == props.Plan.OwnerID {
										<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-zinc-900 text-white shrink-0">Owner</span>
									} else if p.User.ID == props.CurrentUserID {
										<span class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-bg-subtle text-text-secondary border border-border shrink-0">You</span>
									}
								</div>
							}
						</div>
					</div>
				</div>

				<!-- Right Column: Billing Periods & Payment Dues (2 cols) -->
				<div class="lg:col-span-2 space-y-4">
					<div class="bg-bg-card rounded-xl border border-border shadow-card overflow-hidden">
						<div class="px-5 py-4 border-b border-border flex items-center justify-between">
							<h2 class="text-sm font-bold text-text-primary tracking-tight flex items-center gap-2">
								<i data-lucide="receipt" class="w-4 h-4 text-text-secondary"></i>
								Payment Schedule & History
							</h2>
						</div>

						if len(props.BillingPeriods) == 0 {
							<div class="py-12 px-4 text-center">
								<div class="w-10 h-10 rounded-full bg-bg-subtle border border-border flex items-center justify-center text-text-secondary mx-auto mb-2">
									<i data-lucide="calendar" class="w-5 h-5"></i>
								</div>
								<h3 class="text-sm font-semibold text-text-primary">No billing cycles yet</h3>
								<p class="text-xs text-text-secondary mt-0.5">Billing periods will appear here once scheduled.</p>
							</div>
						} else {
							<div class="divide-y divide-border">
								for _, period := range props.BillingPeriods {
									<div class="p-5 space-y-3">
										<div class="flex items-center justify-between">
											<div>
												<span class="text-xs font-bold text-text-primary font-mono">{ period.Name }</span>
												<span class="text-xs text-text-muted ml-2">Due: { period.DueDate.Format("02 Jan 2006") }</span>
											</div>
										</div>

										<!-- Dues Table inside this period -->
										<div class="bg-bg-body rounded-lg border border-border/60 overflow-hidden">
											<table class="w-full border-collapse text-xs">
												<thead>
													<tr class="border-b border-border/60 bg-bg-subtle/50 text-left text-text-secondary text-[11px]">
														<th class="py-2 px-3 font-semibold">Member</th>
														<th class="py-2 px-3 font-semibold text-right">Amount</th>
														<th class="py-2 px-3 font-semibold text-center">Status</th>
														<th class="py-2 px-3 font-semibold text-right">Action</th>
													</tr>
												</thead>
												<tbody class="divide-y divide-border/40">
													for _, due := range period.Dues {
														<tr class={ "hover:bg-bg-hover/50 transition-colors", templ.KV("bg-primary/5 font-medium", due.UserID == props.CurrentUserID) }>
															<td class="py-2.5 px-3">
																<div class="flex items-center gap-1.5">
																	<span>{ due.User.Name }</span>
																	if due.UserID == props.CurrentUserID {
																		<span class="text-[10px] text-primary font-bold">(You)</span>
																	}
																</div>
															</td>
															<td class="py-2.5 px-3 text-right font-mono font-semibold text-text-primary">
																{ utils.FormatRupiah(due.CalculatedPayAmount) }
															</td>
															<td class="py-2.5 px-3 text-center">
																if due.PaymentStatus == models.PaymentStatusPaid {
																	<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
																		<i data-lucide="check" class="w-3 h-3 text-emerald-600"></i>
																		Paid
																	</span>
																} else if due.PaymentStatus == models.PaymentStatusOverdue {
																	<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 text-rose-800 border border-rose-200">
																		<i data-lucide="alert-circle" class="w-3 h-3 text-rose-600"></i>
																		Overdue
																	</span>
																} else if due.PaymentStatus == models.PaymentStatusPending {
																	<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">
																		<i data-lucide="clock" class="w-3 h-3 text-amber-600"></i>
																		Pending
																	</span>
																} else {
																	<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-bg-subtle text-text-muted border border-border">
																		{ string(due.PaymentStatus) }
																	</span>
																}
															</td>
															<td class="py-2.5 px-3 text-right">
																if due.UserID == props.CurrentUserID && (due.PaymentStatus == models.PaymentStatusPending || due.PaymentStatus == models.PaymentStatusOverdue) {
																	<a 
																		href={ templ.SafeURL(fmt.Sprintf("/p/%s", due.UUID)) }
																		class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-primary text-white hover:bg-primary-hover transition-colors shadow-xs"
																	>
																		<i data-lucide="credit-card" class="w-3 h-3"></i>
																		Pay
																	</a>
																} else if due.PaymentStatus == models.PaymentStatusPaid {
																	<span class="text-[11px] text-text-muted">{ due.DueDate.Format("02 Jan") }</span>
																} else {
																	<span class="text-text-muted">—</span>
																}
															</td>
														</tr>
													}
												</tbody>
											</table>
										</div>
									</div>
								}
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	}
}
