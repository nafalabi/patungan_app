package dashboard_pages

import (
	"fmt"
	"patungan_app_echo/internal/models"
	"patungan_app_echo/internal/template/layouts"
	types "patungan_app_echo/internal/template/types"
	"patungan_app_echo/internal/template/utils"
	"time"
)

type MemberDashboardProps struct {
	Title            string
	ActiveNav        string
	Breadcrumbs      []types.Breadcrumb
	UserEmail        string
	UserUID          string
	UserName         string
	ActivePlansCount int
	PendingAmount    float64
	PendingCount     int
	PaidThisMonth    float64
	PendingDues      []models.PaymentDue
	EnrolledPlans    []models.Plan
}

templ MemberDashboard(props MemberDashboardProps) {
	@layouts.Base(layouts.BaseProps{
		Title:       props.Title,
		ActiveNav:   props.ActiveNav,
		Breadcrumbs: props.Breadcrumbs,
		UserEmail:   props.UserEmail,
		UserUID:     props.UserUID,
		Role:        "member",
	}) {
		<div class="space-y-6">
			<!-- Header -->
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
				<div>
					<h1 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight">
						Welcome back, { props.UserName }
					</h1>
					<p class="text-xs md:text-sm text-text-secondary mt-0.5">
						Track your shared subscription plans and upcoming payments
					</p>
				</div>
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-bg-card border border-border text-xs text-text-secondary">
					<i data-lucide="calendar" class="w-3.5 h-3.5"></i>
					<span>{ time.Now().Format("02 Jan 2006") }</span>
				</div>
			</div>

			<!-- Stats Grid -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
				<!-- Active Plans -->
				<div class="p-5 bg-bg-card border border-border rounded-xl shadow-card flex items-center justify-between">
					<div>
						<p class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Active Subscriptions</p>
						<h3 class="text-2xl font-black text-text-primary mt-1 font-mono">{ fmt.Sprintf("%d", props.ActivePlansCount) }</h3>
						<p class="text-[11px] text-text-muted mt-1">Enrolled subscription groups</p>
					</div>
					<div class="w-10 h-10 rounded-xl bg-bg-subtle border border-border flex items-center justify-center text-text-primary">
						<i data-lucide="layers" class="w-5 h-5"></i>
					</div>
				</div>

				<!-- Pending Dues -->
				<div class="p-5 bg-bg-card border border-border rounded-xl shadow-card flex items-center justify-between">
					<div>
						<p class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Pending Dues</p>
						<h3 class="text-2xl font-black text-amber-600 dark:text-amber-500 mt-1 font-mono">{ utils.FormatRupiah(props.PendingAmount) }</h3>
						<p class="text-[11px] text-text-muted mt-1">{ fmt.Sprintf("%d pending payment(s)", props.PendingCount) }</p>
					</div>
					<div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-700">
						<i data-lucide="clock" class="w-5 h-5"></i>
					</div>
				</div>

				<!-- Paid This Month -->
				<div class="p-5 bg-bg-card border border-border rounded-xl shadow-card flex items-center justify-between">
					<div>
						<p class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Paid This Month</p>
						<h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-500 mt-1 font-mono">{ utils.FormatRupiah(props.PaidThisMonth) }</h3>
						<p class="text-[11px] text-text-muted mt-1">Successful contributions</p>
					</div>
					<div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-700">
						<i data-lucide="check-circle" class="w-5 h-5"></i>
					</div>
				</div>
			</div>

			<!-- Pending Payments Section -->
			<div class="bg-bg-card rounded-xl border border-border shadow-card overflow-hidden">
				<div class="px-5 py-4 border-b border-border flex items-center justify-between">
					<div class="flex items-center gap-2">
						<i data-lucide="alert-circle" class="w-4 h-4 text-amber-600"></i>
						<h2 class="text-sm font-bold text-text-primary tracking-tight">Pending Payment Dues</h2>
					</div>
					<span class="text-xs text-text-muted">{ fmt.Sprintf("%d pending", len(props.PendingDues)) }</span>
				</div>

				if len(props.PendingDues) == 0 {
					<div class="py-12 px-4 text-center">
						<div class="w-10 h-10 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 mx-auto mb-2">
							<i data-lucide="check" class="w-5 h-5"></i>
						</div>
						<h3 class="text-sm font-semibold text-text-primary">All caught up!</h3>
						<p class="text-xs text-text-secondary mt-0.5">You have no outstanding payment dues.</p>
					</div>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full border-collapse min-w-[600px]">
							<thead>
								<tr class="bg-bg-subtle/50 border-b border-border text-left">
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider">Plan</th>
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider">Due Date</th>
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider text-right">Amount</th>
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider text-center">Status</th>
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider text-right">Action</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-border">
								for _, due := range props.PendingDues {
									<tr class="hover:bg-bg-hover/50 transition-colors">
										<td class="py-3.5 px-5">
											<div class="flex items-center gap-2.5">
												<div class="w-7 h-7 rounded-md bg-bg-subtle border border-border flex items-center justify-center text-xs font-bold text-text-primary">
													{ utils.SafeInitial(due.Plan.Name, "P") }
												</div>
												<span class="text-xs font-bold text-text-primary">{ due.Plan.Name }</span>
											</div>
										</td>
										<td class="py-3.5 px-5 text-xs text-text-secondary font-mono">{ due.DueDate.Format("02 Jan 2006") }</td>
										<td class="py-3.5 px-5 text-xs font-bold text-text-primary text-right font-mono">{ utils.FormatRupiah(due.CalculatedPayAmount) }</td>
										<td class="py-3.5 px-5 text-center">
											if due.PaymentStatus == "overdue" {
												<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-800 border border-rose-200">
													<i data-lucide="alert-circle" class="w-3 h-3 text-rose-600"></i>
													Overdue
												</span>
											} else {
												<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">
													<i data-lucide="clock" class="w-3 h-3 text-amber-600"></i>
													Pending
												</span>
											}
										</td>
										<td class="py-3.5 px-5 text-right">
											<a 
												href={ templ.SafeURL(fmt.Sprintf("/p/%s", due.UUID)) }
												class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-semibold text-xs bg-primary text-white hover:bg-primary-hover transition-colors shadow-xs"
											>
												<i data-lucide="credit-card" class="w-3.5 h-3.5"></i>
												Pay Now
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Enrolled Plans Grid -->
			<div class="bg-bg-card rounded-xl border border-border shadow-card overflow-hidden">
				<div class="px-5 py-4 border-b border-border flex items-center justify-between">
					<div class="flex items-center gap-2">
						<i data-lucide="layers" class="w-4 h-4 text-text-secondary"></i>
						<h2 class="text-sm font-bold text-text-primary tracking-tight">Your Enrolled Plans</h2>
					</div>
					<a href="/member/plans" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
						View all <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
					</a>
				</div>

				if len(props.EnrolledPlans) == 0 {
					<div class="py-12 px-4 text-center">
						<div class="w-10 h-10 rounded-full bg-bg-subtle border border-border flex items-center justify-center text-text-secondary mx-auto mb-2">
							<i data-lucide="layers" class="w-5 h-5"></i>
						</div>
						<h3 class="text-sm font-semibold text-text-primary">No enrolled plans</h3>
						<p class="text-xs text-text-secondary mt-0.5">You have not been added to any subscription plans yet.</p>
					</div>
				} else {
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-5">
						for _, plan := range props.EnrolledPlans {
							<div class="p-4 bg-bg-body border border-border rounded-xl flex flex-col justify-between hover:border-zinc-400 transition-colors">
								<div>
									<div class="flex justify-between items-start mb-2">
										<h3 class="text-sm font-bold text-text-primary leading-tight">{ plan.Name }</h3>
										<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-bg-subtle text-text-secondary border border-border capitalize">
											{ string(plan.PaymentType) }
										</span>
									</div>
									<div class="mt-2 text-xs font-mono font-bold text-text-primary">
										{ utils.FormatRupiah(plan.TotalPrice) }
										<span class="text-[10px] font-normal text-text-secondary">/ total</span>
									</div>
								</div>
								<div class="mt-4 pt-3 border-t border-border flex items-center justify-between">
									<span class="text-xs text-text-muted flex items-center gap-1">
										<i data-lucide="users" class="w-3.5 h-3.5"></i>
										{ fmt.Sprintf("%d members", len(plan.Participants)) }
									</span>
									<a 
										href={ templ.SafeURL(fmt.Sprintf("/member/plans/%d", plan.ID)) }
										class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline"
									>
										Details <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
									</a>
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}
