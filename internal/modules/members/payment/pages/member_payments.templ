package payment_pages

import (
	"fmt"
	"patungan_app_echo/internal/models"
	"patungan_app_echo/internal/template/layouts"
	types "patungan_app_echo/internal/template/types"
	"patungan_app_echo/internal/template/utils"
)

type MemberPaymentsProps struct {
	Title        string
	ActiveNav    string
	Breadcrumbs  []types.Breadcrumb
	UserEmail    string
	UserUID      string
	StatusFilter string
	PaymentDues  []models.PaymentDue
	TotalPending float64
	TotalPaid    float64
}

templ MemberPayments(props MemberPaymentsProps) {
	@layouts.Base(layouts.BaseProps{
		Title:       props.Title,
		ActiveNav:   props.ActiveNav,
		Breadcrumbs: props.Breadcrumbs,
		UserEmail:   props.UserEmail,
		UserUID:     props.UserUID,
		Role:        "member",
	}) {
		<div class="space-y-6">
			<!-- Header -->
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
				<div>
					<h1 class="text-xl md:text-2xl font-bold text-text-primary tracking-tight">My Payments</h1>
					<p class="text-xs md:text-sm text-text-secondary mt-0.5">
						Track your payment dues, history, and receipts across all subscription plans
					</p>
				</div>
				<!-- Filter Tabs -->
				<div class="flex p-1 bg-bg-card rounded-xl border border-border gap-1">
					<a 
						href="/member/payments" 
						class={ "px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all", templ.KV("bg-primary text-white shadow-xs", props.StatusFilter == "" || props.StatusFilter == "all"), templ.KV("text-text-secondary hover:text-text-primary", props.StatusFilter != "" && props.StatusFilter != "all") }
					>
						All
					</a>
					<a 
						href="/member/payments?status=pending" 
						class={ "px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all", templ.KV("bg-primary text-white shadow-xs", props.StatusFilter == "pending"), templ.KV("text-text-secondary hover:text-text-primary", props.StatusFilter != "pending") }
					>
						Pending
					</a>
					<a 
						href="/member/payments?status=paid" 
						class={ "px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all", templ.KV("bg-primary text-white shadow-xs", props.StatusFilter == "paid"), templ.KV("text-text-secondary hover:text-text-primary", props.StatusFilter != "paid") }
					>
						Paid
					</a>
				</div>
			</div>

			<!-- Summary Cards -->
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<div class="p-5 bg-bg-card border border-border rounded-xl shadow-card flex items-center justify-between">
					<div>
						<p class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Outstanding Dues</p>
						<h3 class="text-2xl font-black text-amber-600 dark:text-amber-500 mt-1 font-mono">{ utils.FormatRupiah(props.TotalPending) }</h3>
						<p class="text-[11px] text-text-muted mt-1">Awaiting payment</p>
					</div>
					<div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-700">
						<i data-lucide="clock" class="w-5 h-5"></i>
					</div>
				</div>

				<div class="p-5 bg-bg-card border border-border rounded-xl shadow-card flex items-center justify-between">
					<div>
						<p class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Total Paid</p>
						<h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-500 mt-1 font-mono">{ utils.FormatRupiah(props.TotalPaid) }</h3>
						<p class="text-[11px] text-text-muted mt-1">All-time settled payments</p>
					</div>
					<div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-700">
						<i data-lucide="check-circle" class="w-5 h-5"></i>
					</div>
				</div>
			</div>

			<!-- Table Container -->
			<div class="w-full bg-bg-card rounded-xl border border-border overflow-hidden shadow-card">
				if len(props.PaymentDues) == 0 {
					<div class="py-12 px-4 text-center">
						<div class="w-10 h-10 rounded-full bg-bg-subtle border border-border flex items-center justify-center text-text-secondary mx-auto mb-2">
							<i data-lucide="receipt" class="w-5 h-5"></i>
						</div>
						<h3 class="text-sm font-semibold text-text-primary">No payments found</h3>
						<p class="text-xs text-text-secondary mt-0.5">No payment dues match the selected filter.</p>
					</div>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full border-collapse min-w-[650px]">
							<thead>
								<tr class="bg-bg-subtle/50 border-b border-border text-left">
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider">Plan</th>
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider">Due Date</th>
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider text-right">Amount</th>
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider text-center">Status</th>
									<th class="py-3 px-5 font-semibold text-text-secondary text-[11px] uppercase tracking-wider text-right">Action</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-border">
								for _, due := range props.PaymentDues {
									<tr class="hover:bg-bg-hover/50 transition-colors">
										<td class="py-3.5 px-5">
											<div class="flex items-center gap-2.5">
												<div class="w-7 h-7 rounded-md bg-bg-subtle border border-border flex items-center justify-center text-xs font-bold text-text-primary">
													{ utils.SafeInitial(due.Plan.Name, "P") }
												</div>
												<div>
													<p class="text-xs font-bold text-text-primary">{ due.Plan.Name }</p>
													<p class="text-[10px] text-text-muted capitalize">{ string(due.Plan.PaymentType) }</p>
												</div>
											</div>
										</td>
										<td class="py-3.5 px-5 text-xs text-text-secondary font-mono">
											{ due.DueDate.Format("02 Jan 2006") }
										</td>
										<td class="py-3.5 px-5 text-xs font-bold text-text-primary text-right font-mono">
											{ utils.FormatRupiah(due.CalculatedPayAmount) }
										</td>
										<td class="py-3.5 px-5 text-center">
											if due.PaymentStatus == models.PaymentStatusPaid {
												<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
													<i data-lucide="check-circle" class="w-3 h-3 text-emerald-600"></i>
													Paid
												</span>
											} else if due.PaymentStatus == models.PaymentStatusOverdue {
												<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-800 border border-rose-200">
													<i data-lucide="alert-circle" class="w-3 h-3 text-rose-600"></i>
													Overdue
												</span>
											} else if due.PaymentStatus == models.PaymentStatusPending {
												<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">
													<i data-lucide="clock" class="w-3 h-3 text-amber-600"></i>
													Pending
												</span>
											} else {
												<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-bg-subtle text-text-muted border border-border">
													{ string(due.PaymentStatus) }
												</span>
											}
										</td>
										<td class="py-3.5 px-5 text-right">
											if due.PaymentStatus == models.PaymentStatusPending || due.PaymentStatus == models.PaymentStatusOverdue {
												<a 
													href={ templ.SafeURL(fmt.Sprintf("/p/%s", due.UUID)) }
													class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-semibold text-xs bg-primary text-white hover:bg-primary-hover transition-colors shadow-xs"
												>
													<i data-lucide="credit-card" class="w-3.5 h-3.5"></i>
													Pay Now
												</a>
											} else {
												<a 
													href={ templ.SafeURL(fmt.Sprintf("/p/%s", due.UUID)) }
													class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-semibold text-xs border border-border text-text-secondary hover:text-text-primary hover:bg-bg-hover transition-colors"
												>
													<i data-lucide="receipt" class="w-3.5 h-3.5"></i>
													Invoice
												</a>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}
